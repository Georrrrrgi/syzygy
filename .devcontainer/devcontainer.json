{
    "name": "SYZYGY",
    "image": "mcr.microsoft.com/devcontainers/rust:latest",
    "features": {
        "ghcr.io/devcontainers/features/rust:1": {},
        "ghcr.io/devcontainers/features/postgres:1": {},
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "bradlc.vscode-tailwindcss"
            ]
        }
    },
    "postCreateCommand": "rustup target add wasm32-unknown-unknown && cargo install trunk && cargo install wasm-bindgen-cli && cargo check -p syzygy-core",
    "forwardPorts": [8080, 3000],
    "containerEnv": {
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5432/syzygy",
        "JWT_SECRET": "syzygy-codespaces-dev-secret"
    }
}
